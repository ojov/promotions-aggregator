generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ScrapeStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model Brand {
  id          String      @id @default(cuid())
  sourceId    String      @unique
  name        String
  slug        String
  mallUrl     String?
  websiteUrl  String?
  hours       Json        @default("[]")
  socialLinks Json        @default("[]")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  promotions  Promotion[]

  @@index([name])
}

model Promotion {
  id           String   @id @default(cuid())
  sourceId     String   @unique
  title        String
  description  String?
  imageUrl     String?
  startDate    DateTime?
  endDate      DateTime?
  dateText     String?
  sourceUrl    String   @unique
  sourcePortal String
  scrapedAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([endDate])
  @@index([title])
}

model ScrapeRun {
  id              String       @id @default(cuid())
  status          ScrapeStatus @default(RUNNING)
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  promotionsFound Int          @default(0)
  promotionsSaved Int          @default(0)
  brandsSaved     Int          @default(0)
  errors          Json         @default("[]")
}
